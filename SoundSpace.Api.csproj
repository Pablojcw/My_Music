<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Sound.Domain\Entities\Album.cs" />
    <Compile Include="Sound.Domain\Entities\Artist.cs" />
    <Compile Include="Sound.Domain\Entities\LibraryMusic.cs" />
    <Compile Include="Sound.Domain\Entities\Music.cs" />
    <Compile Include="Sound.Domain\Entities\Playlist.cs" />
