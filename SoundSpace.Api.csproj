<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>a6f5ac20-7aec-4dda-b17b-ac36940b8b02</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.18.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Sound.Domain\Sound.Domain.csproj" />
    <ProjectReference Include="Sound.Application\Sound.Application.csproj" />
    <ProjectReference Include="SoundSpace.Infrastructure\SoundSpace.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Sound.Domain\**\*.cs" />
    <Compile Remove="Sound.Application\**\*.cs" />
    <Compile Remove="SoundSpace.Infrastructure\**\*.cs" />
  </ItemGroup>

</Project>
